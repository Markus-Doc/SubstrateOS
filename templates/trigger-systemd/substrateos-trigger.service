# SubstrateOS remote trigger duty cycle (ADR-018).
# Template unit: the three literal placeholder tokens are substituted by
# `labctl trigger install`; see README.md in this directory for what they
# mean and for the manual install fallback.

[Unit]
Description=SubstrateOS remote trigger duty cycle (ADR-018)
After=network-online.target
Wants=network-online.target
# No .env at the repo root means this box was never configured; skip the
# unit cleanly instead of starting a loop that can do nothing.
ConditionPathExists=__TRIGGER_REPO__/.env

[Service]
Type=simple
User=__TRIGGER_USER__
WorkingDirectory=__TRIGGER_REPO__
ExecStart=__TRIGGER_VENV__/bin/labctl trigger cycle
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
